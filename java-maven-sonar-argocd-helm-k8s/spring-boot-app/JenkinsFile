pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout Verification') {
            steps {
                sh '''
                    echo "Source code checkout successful"
                    pwd
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = 'http://23.20.34.80:9000'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn sonar:sonar \
                          -Dsonar.login=$SONAR_AUTH_TOKEN \
                          -Dsonar.host.url=$SONAR_URL
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            environment {
                DOCKER_IMAGE = "syedasiff5/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    docker build -t ${DOCKER_IMAGE} .
                '''
            }
        }

        stage('Push Docker Image') {
            environment {
                DOCKER_IMAGE = "syedasiff5/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image("${DOCKER_IMAGE}").push()
                    }
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            environment {
                GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
                GIT_USER_NAME = 'syedasif9376111786-afk'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        git config user.email "your-email@example.com"
                        git config user.name "Syed Asif"

                        DEPLOYMENT_FILE="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                        sed -i -E \
                        "s|syedasiff5/ultimate-cicd:[^[:space:]]*|syedasiff5/ultimate-cicd:${BUILD_NUMBER}|g" \
                        ${DEPLOYMENT_FILE}

                        echo "Updated deployment file:"
                        grep -n "image:" ${DEPLOYMENT_FILE}

                        git add ${DEPLOYMENT_FILE}

                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                        git push \
                        https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                        HEAD:main
                    '''
                }
            }
        }
    }
}
